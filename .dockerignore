# =============================================================================
# .dockerignore — controls the Docker BUILD CONTEXT
# =============================================================================
# When you run `docker build .`, Docker sends the entire current directory to
# its build engine. This file works exactly like .gitignore — listed patterns
# are EXCLUDED from the build context.
#
# Goals:
#   1. Faster builds (less to upload to the daemon).
#   2. Smaller images (fewer files available to accidentally COPY).
#   3. No secrets leak (especially .env).
#   4. No wrong-OS binaries (.venv built for Windows would crash a Linux container).
# =============================================================================

# ─── Secrets — NEVER let these into the image ───────────────────────────────
.env
.env.*
.envrc
*.pem
*.key

# ─── Python artifacts ────────────────────────────────────────────────────────
# Compiled bytecode is regenerated inside the container automatically.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ─── Local virtualenvs (built for the wrong OS!) ─────────────────────────────
# Your .venv was built on Windows. The container is Linux. If we copied it in,
# the binaries inside would crash. The container builds its OWN venv.
.venv/
.venv.*/
venv/
env/

# ─── Django runtime artifacts ────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
staticfiles/                # regenerated by collectstatic inside the container
media/                      # user uploads — provided via volume in production
*.log
test_log.txt

# ─── Frontend (React) — built separately, not part of Django container ───────
# When/if React is in production, we'd add a separate build stage to copy
# frontend/dist/ in. Source code (node_modules, src) is never needed at runtime.
frontend/
.vite/

# ─── Git + version control ───────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ─── Editor/IDE/OS noise ─────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── CI / external service config (not needed at runtime) ────────────────────
.github/
.gitlab-ci.yml
.dockerignore               # don't copy this file into the image
Dockerfile                  # Docker reads it but doesn't need it INSIDE
docker-compose.yml
docker-compose.*.yml

# ─── Documentation (optional — keep README, exclude internal docs) ──────────
CLAUDE.md
ARCHITECTURE.md
SKILL.md

# ─── Personal / scratch files ────────────────────────────────────────────────
roadmap.html
sqlite_data.json
check_batch.py
fix_batch.py
robot_test.py
*.pdf
*.bak
*.tmp

# ─── Build / archive outputs ─────────────────────────────────────────────────
*.tar
*.tar.gz
*.zip
build/
dist/
